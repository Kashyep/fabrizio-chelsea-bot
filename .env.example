# X API app-only credential used to read Fabrizio Romano's public posts.
X_BEARER_TOKEN=replace_me

# OAuth 1.0a user-context credentials for the bot account. The app must have
# Read and write permission. Regenerate the access token after changing it.
X_API_KEY=replace_me
X_API_SECRET=replace_me
X_ACCESS_TOKEN=replace_me
X_ACCESS_TOKEN_SECRET=replace_me

# Bot behavior. Safe defaults are shown.
SOURCE_USERNAME=FabrizioRomano
CHELSEA_TERMS=chelsea,chelsea fc,chelseafc,@chelseafc,#chelseafc
STATE_PATH=data/state.db
DRY_RUN=true
BOOTSTRAP_MODE=baseline
MAX_RESULTS=100
MAX_PAGES=5
MAX_REPOSTS_PER_RUN=5
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
